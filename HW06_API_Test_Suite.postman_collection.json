    {
      "name": "API 2: Apply Coupon",
      "item": [
        {
          "name": "API 2: POST /api/apply-coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.request.headers.upsert({key: 'X-Student-Id', value: '23127503'});\r",
                  "console.log(\"Anti-Cheat Verification: Injected Header X-Student-Id = 23127503 for API 2\");\r",
                  "\r",
                  "let testId = pm.iterationData.get(\"test_id\");\r",
                  "let validToken = pm.environment.get(\"jwt_token\");\r",
                  "\r",
                  "if (testId === \"TC_COUPON_12\") {\r",
                  "    pm.request.headers.remove(\"Authorization\");\r",
                  "} \r",
                  "else if (testId === \"TC_COUPON_34\") {\r",
                  "    pm.request.headers.upsert({key: 'Authorization', value: 'Bearer chuoi_token_rac_12345'});\r",
                  "} \r",
                  "else if (testId === \"TC_COUPON_35\") {\r",
                  "    pm.request.headers.upsert({key: 'Authorization', value: 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE1MTYyMzkwMjJ9.signature'});\r",
                  "} \r",
                  "else {\r",
                  "    pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + validToken});\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let expectedStatus = pm.iterationData.get(\"expected_status\");\r",
