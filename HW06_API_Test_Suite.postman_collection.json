  "item": [
    {
      "name": "API 1: Account Registration",
      "item": [
        {
          "name": "API 1: POST /api/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.request.headers.upsert({key: 'X-Student-Id', value: '23127503'});\r",
                  "console.log(\"Anti-Cheat Verification: Injected Header X-Student-Id = 23127503 for API 1\");\r",
                  "\r",
                  "if (pm.iterationData.get(\"test_id\") === \"TC_REG_25\") {\r",
                  "    pm.request.method = \"GET\";\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let expectedStatus = pm.iterationData.get(\"expected_status\");\r",
                  "let testId = pm.iterationData.get(\"test_id\");\r",
                  "\r",
                  "pm.test(\"[\" + testId + \"] Status code matches expected: \" + expectedStatus, function () {\r",
                  "    pm.response.to.have.status(expectedStatus);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
